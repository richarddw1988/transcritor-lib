<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Dicionário inglês ↔ português local (SQLite gerado do Wiktionary), para dar à tradução os sentidos reais de cada palavra.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Transcritor.Core\Transcritor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Chaves fonéticas: Double Metaphone (Apache 2.0) e Metaphone pt-BR (MIT). -->
    <PackageReference Include="Phonix" />
    <PackageReference Include="MetaphonePtBr" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Transcritor.Tests" />
    <InternalsVisibleTo Include="Transcritor.Traducao" />
  </ItemGroup>
</Project>
